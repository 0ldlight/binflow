# 逆向参考代码（clean-room：永不提交，见 DECISIONS.md ADR-0001）
reverse-src/

# Go 构建产物
bin/
dist/
*.exe
coverage.out
coverage.html

# 依赖与构建
node_modules/
web/dist/
web/playwright-report/
web/test-results/
.next/
__pycache__/
.venv/

# 控制台构建产物（make console 复制进 internal/console/dist）：
# 全局 dist/ 规则会连这个目录一起忽略，这里先解除目录本身、再忽略其
# 内容、最后放回占位 shell —— 占位文件保证 go:embed 在无 node 的
# checkout 上仍然匹配（T-89 占位策略：make build 不依赖 node）。
!internal/console/dist/
internal/console/dist/*
!internal/console/dist/placeholder.html

# 文档构建产物（make docs 复制进 internal/docs/dist）：
# 与 console 同样的占位策略（T-129 复用 T-89 模式）。
!internal/docs/dist/
internal/docs/dist/*
!internal/docs/dist/placeholder.html

# 环境与密钥
.env
.env.*
!.env.example
*.pem
*.key

# 部署产物（Chart 打包、镜像导出）
charts/*.tgz
*.image.tar

# 本地数据与日志
*.log
.DS_Store
data/
*.db
*.sqlite
# 仅忽略仓库根的构建产物二进制；无斜杠裸名会连带忽略 cmd/binflow-server/
# 下所有未跟踪源文件（T-178/T-179/T-180 测试文件曾被吞，2026-08-22 修正）
/binflow-server
/bf
/bf-migrate

# 测试垃圾：storage/adapter 测试在仓库根落的孤儿 fixture（无对应写代码，建议清理）
/f1.bin
/s1.bin
/s2.bin
