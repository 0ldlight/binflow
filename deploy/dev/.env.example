# BinFlow dev compose environment (T-17).
#   cp deploy/dev/.env.example deploy/dev/.env   # then edit
# .env is gitignored (see root .gitignore); .env.example is the tracked
# template. docker compose reads .env from the directory of the compose
# file (deploy/dev/) — or export the variables before `docker compose up`.

# --- admin bootstrap ---------------------------------------------------------

# REQUIRED in practice: the compose file errors out when this is unset, so
# nobody accidentally runs an evaluation instance with the documented
# default password "password". Any value works for a disposable local
# instance, e.g.:
BINFLOW_ADMIN_PASSWORD=change-me

# --- security knobs (defaults shown) ------------------------------------------

# Anonymous content read: ON by default (PRD Q2 / ADR-0009) — content-path
# GET/HEAD needs no credentials. Writes and /binflow/api/** always require
# auth regardless of this flag. Set to false when the instance is reachable
# from anything other than your own machine (NFR-S8).
BINFLOW_SECURITY_ANONYMOUS_ACCESS=true

# --- host binding ---------------------------------------------------------------

# Where the container's 8080 shows up on the host. Loopback by default:
# M1 serves plain HTTP (NFR-S6) — keep it on localhost unless you are on a
# trusted network. To bind a different host port (e.g. 8080 is taken):
#   BINFLOW_BIND_ADDR=127.0.0.1
#   BINFLOW_BIND_PORT=18080
BINFLOW_BIND_ADDR=127.0.0.1
BINFLOW_BIND_PORT=8080
