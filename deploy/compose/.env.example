# BinFlow GA compose environment (T-135, FR-36, PB-04).
#   cp deploy/compose/.env.example deploy/compose/.env   # then edit
# .env is gitignored (see root .gitignore); .env.example is the tracked
# template. docker compose reads .env from the directory of the compose
# file (deploy/compose/) — or export the variables before `docker compose up`.

# ---- admin bootstrap (REQUIRED) ------------------------------------------------

# MANDATORY: docker compose will refuse to start if this is unset or empty.
# Secrets never enter the YAML config file (ADR-0009). Any value works for a
# disposable local instance, e.g.:
BINFLOW_ADMIN_PASSWORD=change-me

# ---- image variant ------------------------------------------------------------

# alpine (default): fully featured, wget-based HEALTHCHECK, ca-certificates + tzdata.
# distroless: shell-free, tiny Go healthcheck-probe binary, minimal attack surface.
#BINFLOW_IMAGE_VARIANT=alpine

# ---- version stamping ---------------------------------------------------------

# Image tag and build-arg version.  Defaults to v1.0.0 (the GA baseline).
#BINFLOW_VER=v1.0.0
#BINFLOW_REVISION=unknown

# ---- host binding -------------------------------------------------------------

# Where the container's 8080 shows up on the host. Loopback by default:
# M1 serves plain HTTP (NFR-S6) — keep it on localhost unless you are on a
# trusted network. To bind a different host port (e.g. 8080 is taken):
#   BINFLOW_BIND_PORT=18080
BINFLOW_BIND_ADDR=127.0.0.1
BINFLOW_BIND_PORT=8080

# ---- security knobs (defaults shown) ------------------------------------------

# Anonymous content read: ON by default (PRD Q2 / ADR-0009) — content-path
# GET/HEAD needs no credentials. Writes and /binflow/api/** always require
# auth regardless of this flag. Set to false when the instance is reachable
# from anything other than your own machine (NFR-S8).
#BINFLOW_SECURITY_ANONYMOUS_ACCESS=true

# ---- auth / token lifetime ----------------------------------------------------

# Token lifetime for BOTH the management API and the docker /v2/token flow
# (expires_in in the token response). Hours, positive integer; 720 (30d)
# is the server default.
#BINFLOW_AUTH__TOKEN_DEFAULT_TTL_HOURS=720

# argon2id memory parameter (MB). 64 is the server default.
#BINFLOW_AUTH__ARGON2_MEMORY_MB=64

# ---- logging ------------------------------------------------------------------

# format: json (structured, default) or console (human-readable).
#BINFLOW_LOGGING__FORMAT=console
# level: debug, info, warn, error.
#BINFLOW_LOGGING__LEVEL=info

# ---- server lifecycle ---------------------------------------------------------

# Graceful shutdown timeout in seconds (default 30).
#BINFLOW_SERVER__GRACEFUL_TIMEOUT_SECONDS=30

# ---- storage ------------------------------------------------------------------

# Upload session TTL in hours (default 24).
#BINFLOW_STORAGE__SESSION_TTL_HOURS=24

# GC grace period in hours (default 24): unreferenced blobs younger than this
# survive collection.
#BINFLOW_STORAGE__GC_GRACE_HOURS=24

# ---- audit --------------------------------------------------------------------

# Audit logging: ON by default.  Set to false to disable.
#BINFLOW_AUDIT__ENABLED=true

# ---- console ------------------------------------------------------------------

# Web console session lifetime in hours (default 24).
#BINFLOW_CONSOLE__SESSION_TTL_HOURS=24

# ---- nginx reverse proxy (optional, --profile nginx) --------------------------
# Uncomment these when using the nginx profile.  The proxy listens on 443
# and terminates TLS; BinFlow stays on plain HTTP bound to loopback.

#NGINX_BIND_ADDR=127.0.0.1
#NGINX_BIND_PORT=8443