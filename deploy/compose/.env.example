# BinFlow GA compose environment (T-135, FR-36, PB-04).
#   cp deploy/compose/.env.example deploy/compose/.env   # then edit
# .env is gitignored (see root .gitignore); .env.example is the tracked
# template. docker compose reads .env from the directory of the compose
# file (deploy/compose/) — or export the variables before `docker compose up`.

# ---- admin bootstrap (REQUIRED) ------------------------------------------------

# MANDATORY: docker compose will refuse to start if this is unset or empty.
# Secrets never enter the YAML config file (ADR-0009). Any value works for a
# disposable local instance, e.g.:
BINFLOW_ADMIN_PASSWORD=change-me

# ---- image variant ------------------------------------------------------------

# alpine (default): fully featured, wget-based HEALTHCHECK, ca-certificates + tzdata.
# distroless: shell-free, tiny Go healthcheck-probe binary, minimal attack surface.
#BINFLOW_IMAGE_VARIANT=alpine

# ---- version stamping ---------------------------------------------------------

# Image tag and build-arg version.  Defaults to v1.0.0 (the GA baseline).
#BINFLOW_VER=v1.0.0
#BINFLOW_REVISION=unknown

# ---- host binding -------------------------------------------------------------

# Where the container's 8080 shows up on the host. Loopback by default:
# M1 serves plain HTTP (NFR-S6) — keep it on localhost unless you are on a
# trusted network. To bind a different host port (e.g. 8080 is taken):
#   BINFLOW_BIND_PORT=18080
BINFLOW_BIND_ADDR=127.0.0.1
BINFLOW_BIND_PORT=8080

# ---- security knobs (defaults shown) ------------------------------------------

# Anonymous content read: ON by default (PRD Q2 / ADR-0009) — content-path
# GET/HEAD needs no credentials. Writes and /binflow/api/** always require
# auth regardless of this flag. Set to false when the instance is reachable
# from anything other than your own machine (NFR-S8).
#BINFLOW_SECURITY_ANONYMOUS_ACCESS=true

# ---- auth / token lifetime ----------------------------------------------------

# Token lifetime for BOTH the management API and the docker /v2/token flow
# (expires_in in the token response). Hours, positive integer; 720 (30d)
# is the server default.
#BINFLOW_AUTH__TOKEN_DEFAULT_TTL_HOURS=720

# argon2id memory parameter (MB). 64 is the server default.
#BINFLOW_AUTH__ARGON2_MEMORY_MB=64

# ---- logging ------------------------------------------------------------------

# format: json (structured, default) or console (human-readable).
#BINFLOW_LOGGING__FORMAT=console
# level: debug, info, warn, error.
#BINFLOW_LOGGING__LEVEL=info

# ---- server lifecycle ---------------------------------------------------------

# Graceful shutdown timeout in seconds (default 30).
#BINFLOW_SERVER__GRACEFUL_TIMEOUT_SECONDS=30

# ---- storage ------------------------------------------------------------------

# Upload session TTL in hours (default 24).
#BINFLOW_STORAGE__SESSION_TTL_HOURS=24

# GC grace period in hours (default 24): unreferenced blobs younger than this
# survive collection.
#BINFLOW_STORAGE__GC_GRACE_HOURS=24

# ---- audit --------------------------------------------------------------------

# Audit logging: ON by default.  Set to false to disable.
#BINFLOW_AUDIT__ENABLED=true

# ---- console ------------------------------------------------------------------

# Web console session lifetime in hours (default 24).
#BINFLOW_CONSOLE__SESSION_TTL_HOURS=24

# ---- nginx reverse proxy (optional, --profile nginx) --------------------------
# Uncomment these when using the nginx profile.  The proxy listens on 443
# and terminates TLS; BinFlow stays on plain HTTP bound to loopback.

#NGINX_BIND_ADDR=127.0.0.1
#NGINX_BIND_PORT=8443

# ---- S3 object-storage backend (optional, --profile s3, T-170) -----------------
# Run with:
#   docker compose -f deploy/compose/docker-compose.yml --profile s3 up -d
# The bundled MinIO keeps objects in the minio-data named volume.  Uncomment
# the block below to switch BinFlow from disk to S3 blob storage; BinFlow
# waits for MinIO's readiness probe and the bucket-init job before starting.

# switch the blob backend to S3 (comment out to run MinIO without using it)
BINFLOW_STORAGE__BACKEND=s3
# bucket / endpoint of the bundled MinIO (defaults shown — override for a
# real S3 or another S3-compatible endpoint)
#BINFLOW_STORAGE__S3__BUCKET=binflow
#BINFLOW_STORAGE__S3__REGION=us-east-1
#BINFLOW_STORAGE__S3__ENDPOINT=http://minio:9000
#BINFLOW_STORAGE__S3__ACCESS_KEY_ID=binflow
#BINFLOW_STORAGE__S3__USE_PATH_STYLE=true

# S3 secret key — env-only, never in a YAML config file (ADR-0009).  For the
# bundled MinIO it must equal MINIO_ROOT_PASSWORD below.
BINFLOW_STORAGE_S3_SECRET_ACCESS_KEY=

# MinIO root credentials (password min 8 chars, env-only).  An empty
# password makes the minio container fail at boot — visibly, by design.
MINIO_ROOT_USER=binflow
MINIO_ROOT_PASSWORD=

# MinIO admin console (https://127.0.0.1:9001) binding — loopback by default.
#MINIO_CONSOLE_BIND_ADDR=127.0.0.1
#MINIO_CONSOLE_BIND_PORT=9001

# ---- OIDC identity provider (M6, ADR-0020 — keep commented until the auth -----
# ---- wiring ships in a server build, T-157) -------------------------------------
# Spellings follow internal/auth: client_secret is env-only (single-underscore
# variable).  Until the wiring lands the config loader fail-fasts on the
# BINFLOW_AUTH__OIDC__* variables below (unknown-variable refusal), so leaving
# them commented is not just tidy — it is what keeps the container bootable.
#BINFLOW_AUTH_OIDC_CLIENT_SECRET=
#BINFLOW_AUTH__OIDC__ISSUER_URL=https://accounts.example.com
#BINFLOW_AUTH__OIDC__CLIENT_ID=binflow
#BINFLOW_AUTH__OIDC__REDIRECT_URL=https://binflow.example.com/binflow/api/v1/oidc/callback
#BINFLOW_AUTH__OIDC__USER_CLAIM=preferred_username
#BINFLOW_AUTH__OIDC__GROUP_CLAIM=groups
#BINFLOW_AUTH__OIDC__ADMIN_GROUP=binflow-admins

# ---- LDAP identity provider (M6, ADR-0020 — keep commented until the auth -----
# ---- wiring ships in a server build, T-157) -------------------------------------
# bind_password is env-only (single-underscore variable).  Same fail-fast
# caveat as OIDC above.
#BINFLOW_AUTH_LDAP_BIND_PASSWORD=
#BINFLOW_AUTH__LDAP__ENABLED=true
#BINFLOW_AUTH__LDAP__URL=ldap://ldap.example.com:389
#BINFLOW_AUTH__LDAP__BASE_DN=dc=example,dc=com
#BINFLOW_AUTH__LDAP__BIND_DN=cn=binflow,ou=services,dc=example,dc=com
#BINFLOW_AUTH__LDAP__USER_FILTER=(&(objectClass=posixAccount)(uid=%s))
#BINFLOW_AUTH__LDAP__USER_ID_ATTR=uid
#BINFLOW_AUTH__LDAP__GROUP_FILTER=(&(objectClass=posixGroup)(memberUid=%s))
#BINFLOW_AUTH__LDAP__GROUP_NAME_ATTR=cn
#BINFLOW_AUTH__LDAP__ADMIN_GROUP=cn=binflow-admins,ou=groups,dc=example,dc=com
#BINFLOW_AUTH__LDAP__POOL_SIZE=5
#BINFLOW_AUTH__LDAP__START_TLS=true