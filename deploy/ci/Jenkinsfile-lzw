// binflow-dev-k8s — intake-27 (2026-10-26), v3: fully git-independent.
// github.com sustained transfers AND dl-cdn/apk downloads are unreliable from
// this network (small requests pass, bodies stall or arrive mangled), so every
// byte moves through the reference Artifactory (round-trip integrity verified)
// and Jobs fetch their own materials in-cluster:
//   1. build Job: initContainer unpacks the source tarball (generic-local/
//      mirror/binflow-src-latest.tar.gz, VERSION file carries the sha) into an
//      emptyDir; kaniko builds with a dir context and pushes to the in-cluster
//      registry (D6). No git anywhere.
//   2. deploy Job: initContainer fetches helm binary + source tarball; main
//      container helm-upgrades binflow-dev in ns lzw (binflow-ci SA, admin
//      password from Secret binflow-lzw-admin).
//   3. smoke: healthz on NodePort 32083.
// The controller only talks to the k8s API (curl + mounted devops:default
// token, RBAC Role binflow-ci-deployer) — no source, no binaries.
// NOTE for conductor: repo copy IS the source of truth; sync the inline job
// script when this file changes (job config.xml CpsFlowDefinition).
pipeline {
  agent any

  options {
    disableConcurrentBuilds()
    buildDiscarder(logRotator(numToKeepStr: '10'))
    timestamps()
  }

  parameters {
    string(name: 'SRC_BASE', defaultValue: 'http://artifactory.devops.svc.cluster.local:8082/artifactory/generic-local/mirror', description: 'Artifactory relay base for tarballs/binaries')
  }

  environment {
    REGISTRY = '192.168.120.36:32100'
    NAMESPACE = 'lzw'
    B_SIDE_URL = 'http://192.168.120.36:32083'
    SA_DIR = '/var/run/secrets/kubernetes.io/serviceaccount'
    K8S_BASE = "https://${env.KUBERNETES_SERVICE_HOST}:${env.KUBERNETES_SERVICE_PORT}"
    no_proxy = 'localhost,127.0.0.1,.svc,.cluster.local,192.168.120.36,10.96.0.1'
    NO_PROXY = 'localhost,127.0.0.1,.svc,.cluster.local,192.168.120.36,10.96.0.1'
  }

  stages {
    stage('Resolve source') {
      steps {
        sh '''
set -eux
SHA=$(curl -sS -m 15 "$SRC_BASE/VERSION" | tr -d "[:space:]")
case "$SHA" in
  [0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]*) ;;
  *) echo "VERSION did not contain a sha: $SHA"; exit 1 ;;
esac
echo "$SHA" > "$WORKSPACE/SRC_SHA"
echo "building source $SHA"
'''
        script { env.SRC_SHA = sh(returnStdout: true, script: 'cat "$WORKSPACE/SRC_SHA"').trim() }
      }
    }

    stage('Build & push image (kaniko Job)') {
      steps {
        sh '''
set -eux
JOB="binflow-img-$SRC_SHA"
TOKEN=$(cat $SA_DIR/token)
CA="--cacert $SA_DIR/ca.crt"
AUTH="Authorization: Bearer $TOKEN"
BASE="$K8S_BASE"
API="$BASE/apis/batch/v1/namespaces/$NAMESPACE/jobs"

curl -sS $CA -H "$AUTH" -X DELETE "$API/$JOB" -o /dev/null || true
cat <<EOF | curl -sS $CA -H "$AUTH" -H "Content-Type: application/yaml" -X POST "$API" --data-binary @-
apiVersion: batch/v1
kind: Job
metadata:
  name: $JOB
  namespace: $NAMESPACE
spec:
  backoffLimit: 0
  activeDeadlineSeconds: 2400
  template:
    spec:
      restartPolicy: Never
      containers:
        - name: kaniko
          image: m.daocloud.io/gcr.io/kaniko-project/executor:v1.23.2
          args:
            - "--dockerfile=deploy/release/Dockerfile.alpine"
            - "--context=dir:///workspace"
            - "--destination=$REGISTRY/binflow:dev-$SRC_SHA"
            - "--insecure"
            - "--registry-mirror=m.daocloud.io"
            - "--snapshot-mode=redo"
          volumeMounts:
            - name: src
              mountPath: /workspace
      initContainers:
        - name: fetch
          image: m.daocloud.io/docker.io/library/alpine:3.20
          env:
            - name: ART_USER
              valueFrom: { secretKeyRef: { name: ref-download, key: user } }
            - name: ART_PASS
              valueFrom: { secretKeyRef: { name: ref-download, key: password } }
          command: ["sh", "-c"]
          args:
            - |
              set -ex
              AB64=$(printf '%s:%s' "$ART_USER" "$ART_PASS" | base64)
              wget --header "Authorization: Basic $AB64" \\
                "$SRC_BASE/binflow-src-latest.tar.gz" -O /workspace/src.tar.gz
              tar -xzf /workspace/src.tar.gz -C /workspace
              rm /workspace/src.tar.gz
          volumeMounts:
            - name: src
              mountPath: /workspace
      volumes:
        - name: src
          emptyDir: {}
EOF
i=0
while [ $i -lt 250 ]; do
  COND=$(curl -sS $CA -H "$AUTH" "$API/$JOB" | grep -o '"type":"[A-Za-z]*","status":"True"' || true)
  case "$COND" in
    *Complete*) echo "kaniko Job complete"; break ;;
    *Failed*)
      echo "kaniko Job FAILED:"
      POD=$(curl -sS $CA -H "$AUTH" "$BASE/api/v1/namespaces/$NAMESPACE/pods?labelSelector=job-name%3D$JOB" | grep -o "\"name\":\"$JOB[^\"]*\"" | head -1 | cut -d'"' -f4)
      curl -sS $CA -H "$AUTH" "$BASE/api/v1/namespaces/$NAMESPACE/pods/$POD/log?tailLines=120" || true
      exit 1 ;;
  esac
  sleep 10
  i=$((i+1))
done
case "$COND" in
  *Complete*) ;;
  *) echo "kaniko Job timed out"; exit 1 ;;
esac
'''
      }
    }

    stage('Deploy to lzw (helm Job)') {
      steps {
        sh '''
set -eux
JOB="binflow-deploy-$SRC_SHA"
TOKEN=$(cat $SA_DIR/token)
CA="--cacert $SA_DIR/ca.crt"
AUTH="Authorization: Bearer $TOKEN"
BASE="$K8S_BASE"
API="$BASE/apis/batch/v1/namespaces/$NAMESPACE/jobs"

curl -sS $CA -H "$AUTH" -X DELETE "$API/$JOB" -o /dev/null || true
cat <<EOF | curl -sS $CA -H "$AUTH" -H "Content-Type: application/yaml" -X POST "$API" --data-binary @-
apiVersion: batch/v1
kind: Job
metadata:
  name: $JOB
  namespace: $NAMESPACE
spec:
  backoffLimit: 0
  activeDeadlineSeconds: 1800
  template:
    spec:
      serviceAccountName: binflow-ci
      restartPolicy: Never
      containers:
        - name: helm
          image: m.daocloud.io/docker.io/library/alpine:3.20
          env:
            - name: ADMIN_PASSWORD
              valueFrom: { secretKeyRef: { name: binflow-lzw-admin, key: password } }
            - name: ART_USER
              valueFrom: { secretKeyRef: { name: ref-download, key: user } }
            - name: ART_PASS
              valueFrom: { secretKeyRef: { name: ref-download, key: password } }
          command: ["sh", "-c"]
          args:
            - |
              set -ex
              AB64=$(printf '%s:%s' "$ART_USER" "$ART_PASS" | base64)
              wget --header "Authorization: Basic $AB64" \\
                "$SRC_BASE/helm-linux-amd64" -O /usr/local/bin/helm
              chmod +x /usr/local/bin/helm
              wget --header "Authorization: Basic $AB64" \\
                "$SRC_BASE/binflow-src-latest.tar.gz" -O /src.tar.gz
              mkdir -p /src && tar -xzf /src.tar.gz -C /src && rm /src.tar.gz
              cd /src
              helm upgrade --install binflow-dev charts/binflow \\
                -n lzw \\
                -f deploy/k8s/lzw-values.yaml \\
                --set image.repository=192.168.120.36:32100 \\
                --set image.tag=dev-$SRC_SHA \\
                --set admin.password="$ADMIN_PASSWORD" \\
                --wait --timeout 8m
              helm list -n lzw
EOF
i=0
while [ $i -lt 200 ]; do
  COND=$(curl -sS $CA -H "$AUTH" "$API/$JOB" | grep -o '"type":"[A-Za-z]*","status":"True"' || true)
  case "$COND" in
    *Complete*) echo "deploy Job complete"; break ;;
    *Failed*)
      echo "deploy Job FAILED:"
      POD=$(curl -sS $CA -H "$AUTH" "$BASE/api/v1/namespaces/$NAMESPACE/pods?labelSelector=job-name%3D$JOB" | grep -o "\"name\":\"$JOB[^\"]*\"" | head -1 | cut -d'"' -f4)
      curl -sS $CA -H "$AUTH" "$BASE/api/v1/namespaces/$NAMESPACE/pods/$POD/log?tailLines=120" || true
      exit 1 ;;
  esac
  sleep 10
  i=$((i+1))
done
case "$COND" in
  *Complete*) ;;
  *) echo "deploy Job timed out"; exit 1 ;;
esac
'''
      }
    }

    stage('Smoke') {
      steps {
        sh '''
set -eux
code=$(curl -sS -m 10 -o /dev/null -w '%{http_code}' $B_SIDE_URL/healthz)
[ "$code" = "200" ] || { echo "healthz=$code"; exit 1; }
curl -sS -m 10 $B_SIDE_URL/healthz
echo "smoke OK on $B_SIDE_URL"
'''
      }
    }
  }

  post {
    failure {
      echo 'chain failed — see stage logs; rollback is a helm retry on the previous tag'
    }
  }
}
