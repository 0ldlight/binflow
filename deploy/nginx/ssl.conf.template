# BinFlow nginx SSL termination template (T-168).
#
# Place this file in your nginx configuration directory (e.g.
# /etc/nginx/conf.d/binflow-ssl.conf) and fill in the placeholders:
#
#   ${DOMAIN}          — your server name (e.g. registry.example.com)
#   ${SSL_CERT}        — path to your TLS certificate (full chain)
#   ${SSL_KEY}         — path to your private key
#   ${BINFLOW_UPSTREAM} — BinFlow backend address (default: http://127.0.0.1:8080)
#
# For docker-compose: mount this file read-only and set the env vars in
# docker-compose.yml (envsubst-on-startup pattern).
#
# TLS 1.2+ only; modern cipher suite (Mozilla intermediate compatibility).
# Requires nginx >= 1.25.1 (the `http2 on` spelling; same major as the
# nginx:1.27-alpine image deploy/compose pins).

# Connection upgrade handling: pass through the client's upgrade request when
# there is one, plain keep-alive otherwise. The map must sit at http{} level —
# conf.d files are included there, so the top of this file is legal.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;

    server_name ${DOMAIN};

    # ---- TLS certificate ----
    ssl_certificate     ${SSL_CERT};
    ssl_certificate_key ${SSL_KEY};

    # ---- TLS protocol & ciphers (Mozilla intermediate, 2024) ----
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers off;

    # ---- Session cache ----
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 10m;
    ssl_session_tickets off;

    # ---- OCSP stapling ----
    # stapling needs a resolver to reach the CA's OCSP responder and the
    # issuer chain (fullchain.pem already carries it; ssl_trusted_certificate
    # is only needed when the cert file does not).
    ssl_stapling            on;
    ssl_stapling_verify     on;
    resolver                127.0.0.53 valid=300s;  # example: systemd-resolved; use 1.1.1.1/8.8.8.8 on other hosts
    resolver_timeout        5s;

    # ---- HSTS (uncomment for production) ----
    # add_header Strict-Transport-Security "max-age=63072000" always;

    # ---- Security headers ----
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;

    # ---- Client request limits ----
    client_max_body_size 0; # BinFlow enforces its own limits; nginx passes through

    # ---- Proxy to BinFlow ----
    location / {
        proxy_pass          ${BINFLOW_UPSTREAM};
        proxy_http_version  1.1;
        proxy_set_header    Host              $host;
        proxy_set_header    X-Real-IP         $remote_addr;
        proxy_set_header    X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header    X-Forwarded-Proto $scheme;
        proxy_set_header    X-Forwarded-Host  $host;
        proxy_set_header    X-Forwarded-Port  $server_port;

        # Connection upgrades only when the client asked for one (see map).
        proxy_set_header    Upgrade           $http_upgrade;
        proxy_set_header    Connection        $connection_upgrade;

        # Timeouts: BinFlow's own timeouts are the authority; nginx stays
        # generous so large artifact uploads/downloads are not cut short.
        proxy_read_timeout      600s;
        proxy_send_timeout      600s;
        proxy_connect_timeout   30s;

        # Disable buffering for large binary uploads/downloads.
        proxy_buffering off;
        proxy_request_buffering off;
    }
}

# ---- HTTP → HTTPS redirect ----
server {
    listen 80;
    listen [::]:80;
    server_name ${DOMAIN};

    # Allow /.well-known/acme-challenge/ for Let's Encrypt HTTP-01 validation.
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}
