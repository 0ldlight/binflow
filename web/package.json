{
  "name": "binflow-console",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "BinFlow web console (vite + React + TS, ADR-0014 decision 4). Built by `make console` and embedded into the single binary via internal/console/dist.",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/assert-tokens.mjs && vite build && node scripts/relink-assets.mjs && node scripts/wire-brand-assets.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "assert:tokens": "node scripts/assert-tokens.mjs",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/material": "^9.4.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.28.0",
    "@playwright/test": "^1.52.0",
    "@types/node": "^26.4.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9.28.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.33.0",
    "vite": "^8.2.2"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
