{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "BinFlow Helm Chart Values",
  "type": "object",
  "properties": {
    "replicaCount": {
      "type": "integer",
      "description": "Number of replicas. Single replica only — HA (multi-replica + object storage) is a M6+ feature.",
      "minimum": 1,
      "maximum": 1
    },
    "image": {
      "type": "object",
      "properties": {
        "repository": { "type": "string" },
        "tag": { "type": "string" },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "items": { "type": "object" }
    },
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "create": { "type": "boolean" },
        "annotations": { "type": "object" },
        "name": { "type": "string" }
      }
    },
    "podAnnotations": { "type": "object" },
    "podSecurityContext": { "type": "object" },
    "securityContext": { "type": "object" },
    "service": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
        "port": { "type": "integer" },
        "nodePort": { "type": ["integer", "null"] }
      }
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "className": { "type": "string" },
        "annotations": { "type": "object" },
        "hosts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "host": { "type": "string" },
              "paths": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "path": { "type": "string" },
                    "pathType": { "type": "string" }
                  }
                }
              }
            }
          }
        },
        "tls": { "type": "array" }
      }
    },
    "resources": { "type": "object" },
    "hpa": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "minReplicas": { "type": "integer", "minimum": 1 },
        "maxReplicas": {
          "type": "integer",
          "description": "Maximum replicas. Must be 1 — single replica constraint; HA is a M6+ feature.",
          "minimum": 1,
          "maximum": 1
        },
        "targetCPUUtilizationPercentage": { "type": "integer" },
        "targetMemoryUtilizationPercentage": { "type": ["integer", "null"] }
      }
    },
    "nodeSelector": { "type": "object" },
    "tolerations": { "type": "array" },
    "affinity": { "type": "object" },
    "persistence": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "accessMode": { "type": "string", "enum": ["ReadWriteOnce", "ReadWriteMany", "ReadOnlyMany"] },
        "size": { "type": "string" },
        "storageClass": { "type": "string" },
        "existingClaim": { "type": "string" },
        "annotations": { "type": "object" }
      }
    },
    "config": {
      "type": "object",
      "properties": {
        "baseUrl": { "type": "string" },
        "dataDir": { "type": "string" },
        "logLevel": { "type": "string", "enum": ["debug", "info", "warn", "error"] },
        "security": {
          "type": "object",
          "properties": {
            "anonymousAccess": { "type": "boolean" }
          }
        },
        "s3": {
          "type": "object",
          "description": "S3 object-storage backend (M6, T-170). secret_access_key is env-only via existingSecret (ADR-0009).",
          "properties": {
            "enabled": { "type": "boolean" },
            "bucket": { "type": "string" },
            "region": { "type": "string" },
            "endpoint": { "type": "string" },
            "accessKeyId": { "type": "string" },
            "usePathStyle": { "type": "boolean" },
            "bucketPrefix": { "type": "string" },
            "uploadPartSize": { "type": "integer", "minimum": 1 },
            "uploadConcurrency": { "type": "integer", "minimum": 1 },
            "existingSecret": { "type": "string" }
          }
        },
        "oidc": {
          "type": "object",
          "description": "OIDC identity provider (M6, ADR-0020). client_secret is env-only via existingSecret.",
          "properties": {
            "enabled": { "type": "boolean" },
            "issuerUrl": { "type": "string" },
            "clientId": { "type": "string" },
            "redirectUrl": { "type": "string" },
            "scopes": { "type": "array", "items": { "type": "string" } },
            "userClaim": { "type": "string" },
            "groupClaim": { "type": "string" },
            "adminGroup": { "type": "string" },
            "readOnlyGroup": { "type": "string" },
            "existingSecret": { "type": "string" }
          }
        },
        "ldap": {
          "type": "object",
          "description": "LDAP identity provider (M6, ADR-0020). bind_password is env-only via existingSecret.",
          "properties": {
            "enabled": { "type": "boolean" },
            "url": { "type": "string" },
            "baseDn": { "type": "string" },
            "bindDn": { "type": "string" },
            "userFilter": { "type": "string" },
            "userIdAttr": { "type": "string" },
            "groupFilter": { "type": "string" },
            "groupBaseDn": { "type": "string" },
            "groupNameAttr": { "type": "string" },
            "adminGroup": { "type": "string" },
            "readOnlyGroup": { "type": "string" },
            "poolSize": { "type": "integer", "minimum": 1 },
            "startTls": { "type": "boolean" },
            "skipTlsVerify": { "type": "boolean" },
            "existingSecret": { "type": "string" }
          }
        },
        "addons": {
          "type": "object",
          "description": "Addon circuit breaker (M10 T-283, ADR-0032 section 15.5). Rendered as addons.disabled — CSV, restart-effective, deletes nothing.",
          "properties": {
            "disabled": {
              "type": "string",
              "description": "CSV of addon ids to switch off ('' = nothing disabled). Values trimmed; unknown ids tolerated; case-sensitive."
            }
          }
        },
        "replication": {
          "type": "object",
          "description": "Push-replication SSRF posture (T-210 / ADR-0025 decision 4). Rendered as replication.allow_private_target.",
          "properties": {
            "allowPrivateTarget": { "type": "boolean" }
          }
        },
        "storage": {
          "type": "object",
          "description": "Storage GC knobs beyond dataDir (the chart's config.storage block).",
          "properties": {
            "gcHoldTtlSeconds": {
              "type": "integer",
              "minimum": 60,
              "description": "storage.gc_hold_ttl_seconds (M9 T-256 / ADR-0031). Domain [60, infinity); the server refuses to boot below 60."
            }
          }
        },
        "auth": {
          "type": "object",
          "description": "Auth token-minting posture (M7 T-219 / ADR-0027). Rendered under the auth section alongside oidc/ldap.",
          "properties": {
            "tokenStepUp": { "type": "boolean" },
            "tokenStepUpGrantTtlSeconds": {
              "type": "integer",
              "minimum": 60,
              "maximum": 3600,
              "description": "auth.token_step_up_grant_ttl_seconds — domain [60, 3600] enforced at boot."
            }
          }
        }
      }
    },
    "admin": {
      "type": "object",
      "properties": {
        "password": { "type": "string" }
      }
    }
  }
}