{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "BinFlow Helm Chart Values",
  "type": "object",
  "properties": {
    "replicaCount": {
      "type": "integer",
      "description": "Number of replicas. Single replica only — HA (multi-replica + object storage) is a M6+ feature.",
      "minimum": 1,
      "maximum": 1
    },
    "image": {
      "type": "object",
      "properties": {
        "repository": { "type": "string" },
        "tag": { "type": "string" },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "items": { "type": "object" }
    },
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "create": { "type": "boolean" },
        "annotations": { "type": "object" },
        "name": { "type": "string" }
      }
    },
    "podAnnotations": { "type": "object" },
    "podSecurityContext": { "type": "object" },
    "securityContext": { "type": "object" },
    "service": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
        "port": { "type": "integer" },
        "nodePort": { "type": ["integer", "null"] }
      }
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "className": { "type": "string" },
        "annotations": { "type": "object" },
        "hosts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "host": { "type": "string" },
              "paths": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "path": { "type": "string" },
                    "pathType": { "type": "string" }
                  }
                }
              }
            }
          }
        },
        "tls": { "type": "array" }
      }
    },
    "resources": { "type": "object" },
    "hpa": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "minReplicas": { "type": "integer", "minimum": 1 },
        "maxReplicas": {
          "type": "integer",
          "description": "Maximum replicas. Must be 1 — single replica constraint; HA is a M6+ feature.",
          "minimum": 1,
          "maximum": 1
        },
        "targetCPUUtilizationPercentage": { "type": "integer" },
        "targetMemoryUtilizationPercentage": { "type": ["integer", "null"] }
      }
    },
    "nodeSelector": { "type": "object" },
    "tolerations": { "type": "array" },
    "affinity": { "type": "object" },
    "persistence": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "accessMode": { "type": "string", "enum": ["ReadWriteOnce", "ReadWriteMany", "ReadOnlyMany"] },
        "size": { "type": "string" },
        "storageClass": { "type": "string" },
        "existingClaim": { "type": "string" },
        "annotations": { "type": "object" }
      }
    },
    "config": {
      "type": "object",
      "properties": {
        "baseUrl": { "type": "string" },
        "dataDir": { "type": "string" },
        "logLevel": { "type": "string", "enum": ["debug", "info", "warn", "error"] },
        "security": {
          "type": "object",
          "properties": {
            "anonymousAccess": { "type": "boolean" }
          }
        },
        "s3": {
          "type": "object",
          "description": "S3 object-storage backend (M6, T-170). secret_access_key is env-only via existingSecret (ADR-0009).",
          "properties": {
            "enabled": { "type": "boolean" },
            "bucket": { "type": "string" },
            "region": { "type": "string" },
            "endpoint": { "type": "string" },
            "accessKeyId": { "type": "string" },
            "usePathStyle": { "type": "boolean" },
            "bucketPrefix": { "type": "string" },
            "uploadPartSize": { "type": "integer", "minimum": 1 },
            "uploadConcurrency": { "type": "integer", "minimum": 1 },
            "existingSecret": { "type": "string" }
          }
        },
        "oidc": {
          "type": "object",
          "description": "OIDC identity provider (M6, ADR-0020). client_secret is env-only via existingSecret.",
          "properties": {
            "enabled": { "type": "boolean" },
            "issuerUrl": { "type": "string" },
            "clientId": { "type": "string" },
            "redirectUrl": { "type": "string" },
            "scopes": { "type": "array", "items": { "type": "string" } },
            "userClaim": { "type": "string" },
            "groupClaim": { "type": "string" },
            "adminGroup": { "type": "string" },
            "readOnlyGroup": { "type": "string" },
            "existingSecret": { "type": "string" }
          }
        },
        "ldap": {
          "type": "object",
          "description": "LDAP identity provider (M6, ADR-0020). bind_password is env-only via existingSecret.",
          "properties": {
            "enabled": { "type": "boolean" },
            "url": { "type": "string" },
            "baseDn": { "type": "string" },
            "bindDn": { "type": "string" },
            "userFilter": { "type": "string" },
            "userIdAttr": { "type": "string" },
            "groupFilter": { "type": "string" },
            "groupBaseDn": { "type": "string" },
            "groupNameAttr": { "type": "string" },
            "adminGroup": { "type": "string" },
            "readOnlyGroup": { "type": "string" },
            "poolSize": { "type": "integer", "minimum": 1 },
            "startTls": { "type": "boolean" },
            "skipTlsVerify": { "type": "boolean" },
            "existingSecret": { "type": "string" }
          }
        },
        "addons": {
          "type": "object",
          "description": "Addon circuit breaker (M10 T-283, ADR-0032 section 15.5). Rendered as addons.disabled — CSV, restart-effective, deletes nothing.",
          "properties": {
            "disabled": {
              "type": "string",
              "description": "CSV of addon ids to switch off ('' = nothing disabled). Values trimmed; unknown ids tolerated; case-sensitive."
            }
          }
        },
        "replication": {
          "type": "object",
          "description": "Push-replication SSRF posture (T-210 / ADR-0025 decision 4). Rendered as replication.allow_private_target.",
          "properties": {
            "allowPrivateTarget": { "type": "boolean" }
          }
        },
        "webhook": {
          "type": "object",
          "description": "Webhook SSRF posture (M13 T-362 / ADR-0041 decision 6). Rendered as webhook.allow_private_target — default FALSE, the deliberate asymmetry against replication (webhook targets are REST-CRUD dynamic, the classic SSRF escalation surface).",
          "properties": {
            "allowPrivateTarget": {
              "type": "boolean",
              "description": "Allow webhook subscription target URLs resolving to private (RFC 1918 / loopback / link-local) hosts. Default false (deny); true is an explicit opt-in for private-network receivers."
            }
          }
        },
        "folderDownload": {
          "type": "object",
          "description": "Directory-zip knob family (M13 T-368 / FR-118.1, the K52 snake_case ruling). Rendered as the folder_download section, six fields, all explicit (T-183 lesson). Resolved values echo at GET /binflow/api/v1/system/settings.",
          "properties": {
            "enabled": {
              "type": "boolean",
              "description": "Master switch for the folder-download endpoint (default false — the M12 as-built)."
            },
            "enabledForAnonymous": {
              "type": "boolean",
              "description": "Allow anonymous principals the endpoint (default false; only read when enabled=true)."
            },
            "maxDownloadSizeMb": {
              "type": "integer",
              "minimum": 1,
              "description": "Maximum zipped download size in MB (default 1024; 0 = unlimited is a YAML-only spelling the env form cannot express)."
            },
            "maxFiles": {
              "type": "integer",
              "minimum": 1,
              "description": "Maximum files in one folder download (default 5000)."
            },
            "maxConcurrentRequests": {
              "type": "integer",
              "minimum": 1,
              "description": "Maximum concurrent folder-download requests (default 10)."
            },
            "enabledEmptyDirectories": {
              "type": "boolean",
              "description": "Include empty directories in the zip (default false)."
            }
          }
        },
        "trashcan": {
          "type": "object",
          "description": "Trashcan retention window (M13 T-368 / FR-118.2). Rendered as trashcan.retention_days.",
          "properties": {
            "retentionDays": {
              "type": "integer",
              "minimum": 1,
              "description": "Days a soft-deleted node stays restorable before the hourly purge cron drops it (default 14 — the M12 as-built, the default-unchanged red line)."
            }
          }
        },
        "storage": {
          "type": "object",
          "description": "Storage GC knobs beyond dataDir (the chart's config.storage block).",
          "properties": {
            "gcHoldTtlSeconds": {
              "type": "integer",
              "minimum": 60,
              "description": "storage.gc_hold_ttl_seconds (M9 T-256 / ADR-0031). Domain [60, infinity); the server refuses to boot below 60."
            }
          }
        },
        "binstore": {
          "type": "object",
          "description": "Standalone binstore.yaml storage chain (M11 T-306 / ADR-0036). Mutually exclusive with config.s3.enabled.",
          "properties": {
            "enabled": { "type": "boolean" },
            "providers": {
              "type": "array",
              "description": "Ordered provider chain: [filestore], [s3] or [filestore, s3] (dual migration chain, filestore first). Anything else is refused at render time and again at boot.",
              "items": { "type": "string", "enum": ["filestore", "s3"] },
              "minItems": 1,
              "maxItems": 2
            },
            "migration": {
              "type": "object",
              "description": "Migration block — legal on and required by the dual [filestore, s3] chain only.",
              "properties": {
                "mode": {
                  "type": "string",
                  "enum": ["", "bypass", "dual-write", "completed"],
                  "description": "migration.mode (empty = no migration block rendered; required on the dual chain)."
                },
                "concurrency": {
                  "type": "integer",
                  "minimum": 0,
                  "description": "migration.concurrency (positive; 0 = omit and take the server default)."
                }
              }
            },
            "s3": {
              "type": "object",
              "description": "S3 provider parameters (read when the chain includes s3). secret_access_key is env-only via existingSecret (ADR-0009).",
              "properties": {
                "bucket": { "type": "string" },
                "region": { "type": "string" },
                "endpoint": { "type": "string" },
                "accessKeyId": { "type": "string" },
                "usePathStyle": { "type": "boolean" },
                "bucketPrefix": { "type": "string" },
                "uploadPartSize": { "type": "integer", "minimum": 1 },
                "uploadConcurrency": { "type": "integer", "minimum": 1 },
                "existingSecret": { "type": "string" }
              }
            }
          }
        },
        "auth": {
          "type": "object",
          "description": "Auth token-minting posture (M7 T-219 / ADR-0027). Rendered under the auth section alongside oidc/ldap.",
          "properties": {
            "tokenStepUp": { "type": "boolean" },
            "tokenStepUpGrantTtlSeconds": {
              "type": "integer",
              "minimum": 60,
              "maximum": 3600,
              "description": "auth.token_step_up_grant_ttl_seconds — domain [60, 3600] enforced at boot."
            }
          }
        }
      }
    },
    "admin": {
      "type": "object",
      "properties": {
        "password": { "type": "string" }
      }
    },
    "masterKey": {
      "type": "object",
      "description": "Instance master key BINFLOW_REMOTE_CREDENTIALS_KEY (M11, env-only): seals remote credentials, replication secrets, auth_configs and GPG keypairs (enc:v1).",
      "properties": {
        "existingSecret": {
          "type": "string",
          "description": "Name of an existing Secret carrying key BINFLOW_REMOTE_CREDENTIALS_KEY. Empty = not injected (fine for a fresh, unsealed instance)."
        }
      }
    }
  }
}