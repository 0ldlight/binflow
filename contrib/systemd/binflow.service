# BinFlow systemd service unit (T-138, FR-39, PB-07).
#
# Installation:
#   sudo cp contrib/systemd/binflow.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now binflow
#
# Or use the bundled install script:
#   sudo bash contrib/systemd/install.sh
#
# The service runs as the system user "binflow" (non-root). The install script
# creates this user and the required directory layout.  If you are installing
# manually, create the user and directories first:
#
#   sudo useradd -r -s /usr/sbin/nologin -M -d /var/lib/binflow binflow
#   sudo mkdir -p /etc/binflow /var/lib/binflow
#   sudo chown -R binflow:binflow /etc/binflow /var/lib/binflow
#
# Config file:
#   The server reads /etc/binflow/binflow.yaml on startup.  Copy and edit
#   dist/config.yaml (or the sample shipped with the binary) as a starting
#   point.  Environment overrides can be placed in /etc/binflow/env (optional).
#
# binstore.yaml storage chain (M11 T-306 / ADR-0036):
#   A standalone /etc/binflow/binstore.yaml next to binflow.yaml owns the
#   storage chain when present — discovered automatically (no flag, no env
#   knob).  Legal chains: [filestore], [s3], [filestore, s3] (+ a migration
#   block: mode bypass|dual-write|completed; filestore first on the dual
#   chain).  While the file owns the chain, chain-scoped env overrides
#   (BINFLOW_STORAGE__BACKEND, BINFLOW_STORAGE__S3__*) in the env file are
#   IGNORED with a WARN — only BINFLOW_STORAGE_S3_SECRET_ACCESS_KEY always
#   applies.  No plaintext secret key may appear in the file (the boot
#   refuses, naming the env escape hatch).  data_dir / session_ttl / gc_*
#   are not chain keys and stay in binflow.yaml.
#
# Instance master key (M11 T-319/T-305):
#   BINFLOW_REMOTE_CREDENTIALS_KEY in /etc/binflow/env (base64, 32 bytes;
#   openssl rand -base64 32) seals remote-repository credentials,
#   replication secrets, auth_configs and GPG keypairs as enc:v1 rows.
#   Generate once and back it up: a fresh instance boots without it, but
#   once any sealed row exists the boot fail-fasts until the SAME key
#   returns.  /etc/binflow is ReadOnlyPaths below — put the env file there
#   (mode 0600, root-owned; the service user only reads it).
#
# M13 operator knobs (T-362/T-368, restart-effective):
#   The same /etc/binflow/env file carries the M13 knob families, or they
#   go in binflow.yaml (webhook/folder_download/trashcan sections — snake_case
#   in the file, double-underscore in env):
#     BINFLOW_WEBHOOK__ALLOW_PRIVATE_TARGET   (default false — the SSRF deny
#       posture, ADR-0041 decision 6; true is an explicit opt-in for
#       private-network receivers)
#     BINFLOW_FOLDER_DOWNLOAD__ENABLED / __ENABLED_FOR_ANONYMOUS /
#       __MAX_DOWNLOAD_SIZE_MB / __MAX_FILES / __MAX_CONCURRENT_REQUESTS /
#       __ENABLED_EMPTY_DIRECTORIES           (FR-118.1, defaults = M12 as-built)
#     BINFLOW_TRASHCAN__RETENTION_DAYS        (FR-118.2, default 14)
#   The resolved knob values echo at GET /binflow/api/v1/system/settings
#   (admin token).  chartsBaseUrl is NOT one of these: it is a
#   per-repository field on helm remote repositories (repositories API).
#
# Security:
#   - Runs as non-root (User=binflow)
#   - NoNewPrivileges=yes (no setuid / capability escalation)
#   - ProtectSystem=strict (read-only /usr, /boot, /etc; exceptions below)
#   - ProtectHome=yes (no access to /home, /root, /run/user)
#   - Data is written only to /var/lib/binflow (ReadWritePaths)
#
# Graceful stop (T-168):
#   systemctl stop sends SIGTERM (KillSignal pinned below for clarity — it is
#   systemd's default). The server then drains in-flight requests for up to
#   server.graceful_timeout_seconds (30s default) before closing the HTTP
#   server, the storage Engine and the metadata Store; journalctl -u binflow
#   shows "shutting down gracefully" once the drain has completed. 45s of
#   TimeoutStopSec gives that full 30s drain window plus teardown margin
#   before systemd's SIGKILL, so a loaded instance is never killed mid-drain.

[Unit]
Description=BinFlow artifact repository
Documentation=https://github.com/example/binflow
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=binflow
Group=binflow
WorkingDirectory=/var/lib/binflow
ExecStart=/usr/local/bin/binflow-server serve -c /etc/binflow/binflow.yaml
Restart=on-failure
RestartSec=5s
KillSignal=SIGTERM
TimeoutStopSec=45

# Security hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/binflow
# Allow reading the config and env file from /etc/binflow
ReadOnlyPaths=/etc/binflow

# Optional environment file (not mandatory — no error if missing)
EnvironmentFile=-/etc/binflow/env

# Limit file descriptors
LimitNOFILE=65536

# Service-created files group-readable at most (the data dir itself is 0700;
# this tightens everything the process creates with default modes, e.g. the
# sqlite database file)
UMask=0027

# Allowed capabilities: none beyond default
CapabilityBoundingSet=

# Private /tmp and /dev
PrivateTmp=yes
PrivateDevices=yes

# Network only (no raw sockets, no tun/tap)
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

# System call filter
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target